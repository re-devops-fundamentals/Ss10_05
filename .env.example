# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Sao chép tệp này thành .env và điền các thông tin bảo mật thực tế của bạn:
# cp .env.example .env
# ==============================================================================

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Cấu hình Cổng dịch vụ Web Backend
PORT=8080
